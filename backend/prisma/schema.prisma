generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Employee
}

model User {
  id Int @default(autoincrement()) @id
  name String?
  email String @unique
  password String
  role UserRole @default(Employee)
  createdAt DateTime @default(now())
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model Document {
  id               String         @id @default(cuid())
  title            String
  originalName     String
  fileUrl          String
  mimeType         String
  fileSize         Int?

  status           DocumentStatus @default(PENDING)

  processedAt      DateTime?
  errorMessage     String?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}