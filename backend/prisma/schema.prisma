generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Admin
  Employee
}

model User {
  id Int @default(autoincrement()) @id
  name String?
  email String @unique
  password String
  role UserRole @default(Employee)
  createdAt DateTime @default(now())
}